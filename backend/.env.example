CORS_ORIGINS=http://localhost:5104,http://127.0.0.1:5104
DATA_DIR=data
# fastembed = local open-source embeddings (one-time ~70 MB download); none = keyword search only
EMBEDDINGS=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional: grounded conversational answers from a local LLM via Ollama (free). "none" disables.
LLM_PROVIDER=none
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
MAX_UPLOAD_MB=15
MAX_DOCUMENTS=50
MIN_SEMANTIC_SCORE=0.55
